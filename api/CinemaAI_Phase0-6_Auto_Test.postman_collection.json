    "name": "CinemaAI Phase 0-6 Auto Test",
    "description": "Auto-test collection generated from api phase 0-6 docs. Run against local backend. Configure seed admin credentials through .env and collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runSuffix')) { pm.collectionVariables.set('runSuffix', Date.now().toString()); }",
          "const future = new Date(Date.now() + 9 * 24 * 60 * 60 * 1000);",
          "future.setHours(19, 30, 0, 0);",
          "pm.collectionVariables.set('futureShowtimeAt', future.toISOString().slice(0, 19));",
          "pm.collectionVariables.set('longDescription', 'CinemaAI automated test description '.repeat(8).trim());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "let body = {};",
          "try { body = pm.response.json(); } catch (error) { body = {}; }",
          "pm.collectionVariables.set('lastStatus', pm.response.code);",
          "if (body.message) pm.collectionVariables.set('lastMessage', body.message);",
          "if (body.success !== undefined) pm.collectionVariables.set('lastSuccess', body.success);",
          "if (body.data?.accessToken) pm.collectionVariables.set('accessToken', body.data.accessToken);",
          "if (body.data?.refreshToken) pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
          "if (body.data?.qrCode) pm.collectionVariables.set('qrCode', body.data.qrCode);",
          "if (body.data?.bookingCode) pm.collectionVariables.set('bookingCode', body.data.bookingCode);",
          "if (body.data?.paymentUrl) { pm.collectionVariables.set('paymentUrl', body.data.paymentUrl); try { const u = new URL(body.data.paymentUrl); pm.collectionVariables.set('vnpTxnRef', u.searchParams.get('vnp_TxnRef') || ''); } catch (e) {} }"
        ]
      }
    }
  ],
